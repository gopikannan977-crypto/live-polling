# PulsePoll Environment Configuration
PORT=3000
MONGODB_URI="mongodb://localhost:27017/pulsepoll"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="pulsepoll-super-secret-jwt-key-change-in-production-2026"
